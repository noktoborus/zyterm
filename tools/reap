#!/usr/bin/env -S python3 -I
# Runs a command so that nothing it starts is left behind as a zombie.
#
# A process whose parent is gone is handed to the nearest ancestor that is a
# subreaper, and to PID 1 when there is none. In this container PID 1 is not an
# init and never waits for what it is handed, so every orphan that exits stays
# a zombie until the container goes: a tmux server a test started, the vim it
# ran, an Xvfb started in the background.
#
# This makes itself a subreaper (PR_SET_CHILD_SUBREAPER, Linux 3.4), runs the
# command, and waits for every process of the tree as it exits — the command,
# its children, and whatever is handed to it when their parents go. When the
# command ends, what it left running is dealt with by the mode:
#
#   reap -- cmd        what is left gets SIGTERM, SIGKILL after --grace
#                      seconds, and is waited for; nothing outlives the call
#   reap --wait -- cmd what is left is waited for until it exits by itself:
#                      the way to start a service — Xvfb, the window — that a
#                      later command stops by name, run in the background
#
# The exit code is the command's, 128 + the signal when a signal ended it.
# SIGINT, SIGTERM and SIGHUP sent to this are passed on to the command.
#
# tini and dumb-init were looked at. Not as PID 1, tini -s reaps what it is
# handed but exits with its command, and what the command left goes back to
# PID 1; dumb-init reaps only as PID 1.
#
# Python and its standard library only: it runs before anything is built, so
# it can run cargo itself.

import argparse
import ctypes
import errno
import os
import signal
import subprocess
import sys
import time

PR_SET_CHILD_SUBREAPER = 36


def subreaper():
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        error = ctypes.get_errno()
        sys.exit(f"reap: prctl(PR_SET_CHILD_SUBREAPER): {os.strerror(error)}")


def descendants(root):
    """The processes under `root`, read from /proc: a pid and its parent."""
    parents = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(f"/proc/{name}/stat", "rb") as stat:
                fields = stat.read().rsplit(b")", 1)[1].split()
        except OSError:
            continue
        parents[int(name)] = int(fields[1])
    found = []
    wanted = [root]
    while wanted:
        parent = wanted.pop()
        children = [pid for pid, of in parents.items() if of == parent]
        found.extend(children)
        wanted.extend(children)
    return found


def reap_ready():
    """Waits for every child that has exited, at once. False when none is left."""
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return False
        if pid == 0:
            return True


def wait_all(deadline):
    """Waits for the children, until none is left or the deadline passes."""
    while reap_ready():
        if deadline is not None and time.monotonic() >= deadline:
            return False
        time.sleep(0.05)
    return True


def signal_all(signum):
    for pid in descendants(os.getpid()):
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass


def main():
    parser = argparse.ArgumentParser(
        prog="reap",
        description="Run a command and leave no zombie of anything it starts.",
    )
    parser.add_argument(
        "--wait",
        action="store_true",
        help="when the command ends, wait for what it left until it exits by itself",
    )
    parser.add_argument(
        "--grace",
        type=float,
        default=3.0,
        help="seconds between SIGTERM and SIGKILL of what is left (default 3)",
    )
    parser.add_argument("command", nargs=argparse.REMAINDER)
    options = parser.parse_args()
    command = options.command
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        parser.error("a command is wanted, after --")

    subreaper()
    try:
        child = subprocess.Popen(command)
    except OSError as error:
        sys.exit(f"reap: {command[0]}: {error.strerror}")

    ended = []

    def forward(signum, _frame):
        if ended:
            signal_all(signum)
            return
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, forward)

    status = None
    while status is None:
        try:
            pid, raw = os.waitpid(-1, 0)
        except InterruptedError:
            continue
        except ChildProcessError:
            break
        if pid == child.pid:
            status = raw
            ended.append(pid)
    code = 0
    if status is not None:
        code = os.waitstatus_to_exitcode(status)
        code = 128 - code if code < 0 else code

    if options.wait:
        wait_all(None)
    elif descendants(os.getpid()):
        signal_all(signal.SIGTERM)
        if not wait_all(time.monotonic() + options.grace):
            signal_all(signal.SIGKILL)
            wait_all(None)
    else:
        wait_all(None)
    sys.exit(code)


if __name__ == "__main__":
    try:
        main()
    except OSError as error:
        if error.errno != errno.ECHILD:
            raise
